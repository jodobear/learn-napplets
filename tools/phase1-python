#!/bin/sh
# Bootstrap and certify the recorded Phase 1 interpreter before forwarding argv.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
MANIFEST="$ROOT/.planning/spikes/_shared/toolchain-environment.json"
BOOTSTRAP="$ROOT/tools/phase1-bootstrap.py"
VERIFIER="$ROOT/tools/verify-phase1-toolchain.py"
TARGET="$ROOT/.research/phase1-certified-tools-4"

if [ ! -r "$MANIFEST" ] || [ ! -r "$BOOTSTRAP" ] || [ ! -r "$VERIFIER" ]; then
  printf '%s\n' "phase1-python: bootstrap or toolchain verification inputs are unavailable" >&2
  exit 1
fi

INTERPRETER=$(awk -F '"' '/"isolatedInterpreter"[[:space:]]*:/ {print $4; exit}' "$MANIFEST")
case "$INTERPRETER" in
  ''|/*|*'..'*)
    printf '%s\n' "phase1-python: invalid recorded isolated interpreter path" >&2
    exit 1
    ;;
esac
INTERPRETER="$ROOT/$INTERPRETER"
if [ ! -x "$INTERPRETER" ]; then
  printf '%s\n' "phase1-python: approved isolated interpreter is unavailable: $INTERPRETER" >&2
  exit 1
fi

"$INTERPRETER" -I -S "$BOOTSTRAP" --environment "$MANIFEST"
"$INTERPRETER" -I -S "$VERIFIER" --verify-toolchain

if [ "${1-}" = "--verify-toolchain" ] && [ "$#" -eq 1 ]; then
  exit 0
fi
if [ ! -x "$TARGET/bin/python" ]; then
  printf '%s\n' "phase1-python: fresh certified target is unavailable" >&2
  exit 1
fi
exec "$TARGET/bin/python" "$@"
