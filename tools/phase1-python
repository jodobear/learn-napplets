#!/bin/sh
# Bootstrap the recorded interpreter before any Phase 1 Python process.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
MANIFEST="$ROOT/.planning/spikes/_shared/toolchain-environment.json"
BOOTSTRAP="$ROOT/tools/phase1-bootstrap.py"

if [ ! -r "$MANIFEST" ] || [ ! -r "$BOOTSTRAP" ]; then
  printf '%s\n' "phase1-python: bootstrap inputs are unavailable" >&2
  exit 1
fi

INTERPRETER=$(awk -F '"' '/"isolatedInterpreter"[[:space:]]*:/ {print $4; exit}' "$MANIFEST")
case "$INTERPRETER" in
  ''|/*|*'..'*)
    printf '%s\n' "phase1-python: invalid recorded isolated interpreter path" >&2
    exit 1
    ;;
esac
INTERPRETER="$ROOT/$INTERPRETER"
if [ ! -x "$INTERPRETER" ]; then
  printf '%s\n' "phase1-python: approved isolated interpreter is unavailable: $INTERPRETER" >&2
  exit 1
fi

"$INTERPRETER" -I -S "$BOOTSTRAP" --environment "$MANIFEST"

ATTESTATION="$ROOT/.planning/spikes/_shared/phase1-wheelhouse-attestation.json"
VERIFIER="$ROOT/tools/verify-phase1-wheelhouse.py"
if [ ! -r "$ATTESTATION" ] || [ ! -x "$VERIFIER" ]; then
  printf '%s\n' "phase1-python: ordinary forwarding is denied until Plan 01-44 wheelhouse certification is present and valid" >&2
  exit 1
fi
"$INTERPRETER" -I -S "$VERIFIER" --attestation "$ATTESTATION"
exec "$INTERPRETER" "$@"
