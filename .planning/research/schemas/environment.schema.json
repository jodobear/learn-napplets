{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-napplets.local/schemas/environment.schema.json",
  "title": "Phase 1 reproducibility environment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "kind", "os", "container", "browsers", "runtimes", "packageManager", "dependencies", "environmentFlags", "commandHashes"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^ENV-[A-Z0-9][A-Z0-9-]*$"},
    "kind": {"const": "environment"},
    "os": {"type": "string", "minLength": 1},
    "container": {"type": "string", "minLength": 1},
    "browsers": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["family", "version", "executableSha256"], "properties": {"family": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "executableSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "runtimes": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}, "minProperties": 1},
    "packageManager": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
    "dependencies": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "version", "sha256"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "environmentFlags": {"type": "array", "items": {"type": "string"}},
    "commandHashes": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["command", "sha256"], "properties": {"command": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
  }
}
