{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-napplets.local/schemas/claim.schema.json",
  "title": "Phase 1 source-linked claim record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "statement", "rawOrigin", "assertionKind", "evidenceClass", "maturity", "state", "stateReason", "uncertainty", "impacts", "sourceRelations", "review", "blocking"],
  "properties": {
    "id": {"type": "string", "pattern": "^CLM-[A-Z0-9][A-Z0-9-]*$"},
    "kind": {"const": "claim"},
    "statement": {"type": "string", "minLength": 1},
    "rawOrigin": {"enum": ["upstream-fact", "proposal", "observed-implementation", "project-policy", "inference"]},
    "assertionKind": {"enum": ["upstream-fact", "proposal", "observed-implementation", "project-policy", "inference"]},
    "evidenceClass": {"enum": ["specification", "proposal", "implementation", "measurement", "project-policy", "inference"]},
    "maturity": {"enum": ["accepted", "draft", "experimental", "implementation-specific", "unknown"]},
    "state": {"enum": ["verified", "disputed", "provisional", "blocked", "stale"]},
    "stateReason": {"type": "string", "minLength": 1},
    "uncertainty": {"type": "object", "additionalProperties": false, "required": ["state", "reason"], "properties": {"state": {"enum": ["none", "limited", "material"]}, "reason": {"type": "string", "minLength": 1}}},
    "impacts": {"type": "object", "additionalProperties": false, "required": ["requirements", "phases"], "properties": {"requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{3,4}-\\d{2}$"}}, "phases": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^\\d{2}$"}}}},
    "sourceRelations": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["sourceId", "relation", "role", "locator", "excerptSha256"], "properties": {"sourceId": {"type": "string", "pattern": "^SRC-[A-Z0-9][A-Z0-9-]*$"}, "relation": {"enum": ["supports", "contradicts", "measures", "affects", "recommends", "supersedes"]}, "role": {"enum": ["primary", "independent-corroboration", "context"]}, "locator": {"type": "string", "minLength": 1}, "excerptSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "review": {"type": "object", "additionalProperties": false, "required": ["owner", "status", "requiredRoles"], "properties": {"owner": {"type": "string", "minLength": 1}, "status": {"enum": ["pending", "reviewed", "approved"]}, "requiredRoles": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "approvedBy": {"type": "string", "minLength": 1}, "approvedAt": {"type": "string", "format": "date-time"}}},
    "blocking": {"type": "boolean"},
    "blockedDetails": {"type": "object", "additionalProperties": false, "required": ["scope", "safeFallback", "approver", "date", "revisitCriterion"], "properties": {"scope": {"type": "string", "minLength": 1}, "safeFallback": {"type": "string", "minLength": 1}, "approver": {"type": "string", "minLength": 1}, "date": {"type": "string", "format": "date"}, "revisitCriterion": {"type": "string", "minLength": 1}}}
  },
  "allOf": [{"if": {"properties": {"state": {"const": "blocked"}}, "required": ["state"]}, "then": {"required": ["blockedDetails"]}}]
}
