{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://learn-napplets.local/schemas/open-question.schema.json","title":"Impact-scoped open question","type":"object","additionalProperties":false,"required":["id","kind","question","status","sourceRefs","impacts","blockedDecisions","resolutionCriteria","owner","review","history"],"properties":{"id":{"type":"string","pattern":"^OQ-[A-Z0-9][A-Z0-9-]*$"},"kind":{"const":"open-question"},"question":{"type":"string","minLength":1},"status":{"enum":["open","blocked","resolved","stale"]},"sourceRefs":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^(SRC|CLM|DRF)-[A-Z0-9][A-Z0-9-]*$"}},"impacts":{"type":"object","additionalProperties":false,"required":["requirements","phases"],"properties":{"requirements":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^[A-Z][A-Z0-9]{3,4}-\\d{2}$"}},"phases":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^\\d{2}$"}}}},"blockedDecisions":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"resolutionCriteria":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"owner":{"type":"string","minLength":1},"review":{"type":"object","additionalProperties":false,"required":["status","requiredRoles"],"properties":{"status":{"enum":["pending","reviewed","approved"]},"requiredRoles":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}}},"history":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["at","status","reason"],"properties":{"at":{"type":"string","format":"date-time"},"status":{"type":"string","minLength":1},"reason":{"type":"string","minLength":1}}}}}}