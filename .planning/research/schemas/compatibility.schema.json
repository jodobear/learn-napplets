{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-napplets.local/schemas/compatibility.schema.json",
  "title": "Immutable-baseline compatibility record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "sourceBaseline", "packages", "runtimes", "examples", "fixtures", "knownDrift", "testEvidence", "observedAt", "releaseState", "currentWork"],
  "properties": {
    "id": {"type": "string", "pattern": "^CMP-[A-Z0-9][A-Z0-9-]*$"},
    "kind": {"const": "compatibility"},
    "sourceBaseline": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pin"}},
    "packages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}},
    "runtimes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}},
    "examples": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}},
    "fixtures": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}},
    "knownDrift": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "testEvidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}},
    "observedAt": {"type": "string", "format": "date-time"},
    "releaseState": {"$ref": "#/$defs/pin"},
    "currentWork": {"$ref": "#/$defs/pin"}
  },
  "$defs": {
    "ref": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*-[A-Z0-9][A-Z0-9-]*$"},
    "pin": {"type": "object", "additionalProperties": false, "required": ["sourceId", "commitSha", "path", "contentSha256"], "properties": {"sourceId": {"type": "string", "pattern": "^SRC-[A-Z0-9][A-Z0-9-]*$"}, "commitSha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}, "path": {"type": "string", "minLength": 1}, "contentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  }
}
