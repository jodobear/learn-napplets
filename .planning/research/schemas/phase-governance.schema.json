{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-napplets.local/schemas/phase-governance.schema.json",
  "title": "Reusable phase ownership and exit-evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "kind", "phase", "owner", "requiredApprover", "requirements", "exitEvidence", "verification", "approval", "phaseResult"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^PGV-[A-Z0-9][A-Z0-9-]*$"},
    "kind": {"const": "phase-governance"},
    "phase": {"type": "string", "pattern": "^\\d{2}$"},
    "owner": {"type": "string", "minLength": 1},
    "requiredApprover": {"type": "string", "minLength": 1},
    "requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{3,4}-\\d{2}$"}},
    "exitEvidence": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "measure", "expected", "actual", "path"], "properties": {"id": {"type": "string", "pattern": "^(SRC|CLM|SPK|ADR|LES)-[A-Z0-9][A-Z0-9-]*$"}, "measure": {"type": "string", "minLength": 1}, "expected": {"type": "string", "minLength": 1}, "actual": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}}}},
    "verification": {"type": "object", "additionalProperties": false, "required": ["gsdState", "validatedAt", "validator"], "properties": {"gsdState": {"enum": ["pending", "passed", "blocked"]}, "validatedAt": {"type": "string", "format": "date-time"}, "validator": {"type": "string", "minLength": 1}}},
    "approval": {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"enum": ["pending", "approved", "rejected"]}, "approvedBy": {"type": "string", "minLength": 1}, "approvedAt": {"type": "string", "format": "date-time"}}},
    "phaseResult": {"enum": ["passed", "blocked"]}
  },
  "allOf": [{"if": {"properties": {"approval": {"properties": {"status": {"const": "approved"}}}}}, "then": {"properties": {"approval": {"required": ["approvedBy", "approvedAt"]}}}}]
}
